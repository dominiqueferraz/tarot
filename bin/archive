#!/usr/bin/env python3

import argparse
import fcntl
from pathlib import Path
import plistlib
import re
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
APP_NAME = "Tarot Squared"
BUNDLE_ID = "group.kleinfour.games.tarot"
PUBSPEC = ROOT / "pubspec.yaml"
IOS_BUILD = ROOT / "build/ios"
VERSION_PARTS = ("major", "minor", "patch")
VERSION_LINE = re.compile(r"^version: (\d+\.\d+\.\d+)\+([1-9]\d*)$", re.MULTILINE)


def run(*command):
    subprocess.run(command, cwd=ROOT, check=True)


def pubspec_version(contents):
    versions = VERSION_LINE.findall(contents)
    if len(versions) != 1:
        raise ValueError("Set a single version: MAJOR.MINOR.PATCH+BUILD in pubspec.yaml.")
    return versions[0]


def save_version(original_version, build_name, build_number):
    contents = PUBSPEC.read_text(encoding="utf-8")
    if pubspec_version(contents) != original_version:
        raise ValueError("pubspec.yaml version changed during archiving. The archive was retained.")
    updated = VERSION_LINE.sub(f"version: {build_name}+{build_number}", contents)
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=PUBSPEC.parent, delete=False) as stream:
        pending = Path(stream.name)
        try:
            stream.write(updated)
            stream.flush()
            pending.chmod(PUBSPEC.stat().st_mode & 0o777)
            pending.replace(PUBSPEC)
        finally:
            pending.unlink(missing_ok=True)


def archive_app(args):
    original_version = pubspec_version(PUBSPEC.read_text(encoding="utf-8"))
    build_name, build_number = original_version
    if args.bump is not None:
        components = [int(part) for part in build_name.split(".")]
        index = VERSION_PARTS.index(args.bump)
        components[index] += 1
        components[index + 1:] = [0] * (2 - index)
        build_name = ".".join(map(str, components))
        build_number = str(int(build_number) + 1)

    if args.bump in ("major", "minor"):
        try:
            answer = input(f"Archive {APP_NAME} {build_name} ({build_number})? [y/N] ")
        except EOFError:
            answer = ""
        if answer.strip().lower() not in ("y", "yes"):
            print("Archive canceled.")
            return

    flutter_command = [
        ROOT / "bin/flutter", "build", "ios", "--release",
        "--flavor", APP_NAME, "--config-only", f"--build-name={build_name}",
        f"--build-number={build_number}",
    ]
    if args.no_codesign:
        flutter_command.append("--no-codesign")
    print(f"Preparing Flutter release {build_name} ({build_number})", flush=True)
    run(*flutter_command)

    archives = IOS_BUILD / "archives"
    archives.mkdir(parents=True, exist_ok=True)
    archive_folder = Path(tempfile.mkdtemp(prefix=f"{build_name}+{build_number}-", dir=archives))
    archive = archive_folder / f"{APP_NAME}.xcarchive"
    command = [
        "xcodebuild", "-quiet", "-workspace", f"ios/{APP_NAME}.xcworkspace",
        "-scheme", APP_NAME, "-destination", "generic/platform=iOS",
        "-derivedDataPath", str(IOS_BUILD / "archive-derived"),
        "-archivePath", str(archive),
    ]
    if args.no_codesign:
        command.append("CODE_SIGNING_ALLOWED=NO")
        print(f"Archiving {APP_NAME} without signing", flush=True)
    else:
        command.append("-allowProvisioningUpdates")
        print(f"Archiving {APP_NAME} with automatic development signing", flush=True)
    run(*command, "archive")

    with (archive / "Info.plist").open("rb") as metadata:
        archive_info = plistlib.load(metadata)
    for key in ("Name", "SchemeName"):
        if archive_info.get(key) != APP_NAME:
            raise ValueError(f"Expected archive {key}={APP_NAME}, found {archive_info.get(key)!r}.")
    app_path = archive_info.get("ApplicationProperties", {}).get("ApplicationPath")
    if app_path != f"Applications/{APP_NAME}.app":
        raise ValueError(f"Unexpected archived product: {app_path!r}.")
    app = archive / "Products" / app_path
    with (app / "Info.plist").open("rb") as metadata:
        info = plistlib.load(metadata)
    for key, expected in {
        "CFBundleIdentifier": BUNDLE_ID,
        "CFBundleShortVersionString": build_name,
        "CFBundleVersion": build_number,
    }.items():
        if info.get(key) != expected:
            raise ValueError(f"Expected {key}={expected}, found {info.get(key)!r} in {app}.")
    if info.get("ITSAppUsesNonExemptEncryption") is not False:
        raise ValueError(f"Expected ITSAppUsesNonExemptEncryption=false in {app}.")

    if not args.no_codesign:
        if not (app / "embedded.mobileprovision").is_file():
            raise ValueError(f"Missing provisioning profile in {app}.")
        run("codesign", "--verify", "--deep", "--strict", str(app))

    print(f"Verified archive: {archive}", flush=True)
    if args.bump is not None and not args.no_codesign:
        save_version(original_version, build_name, build_number)
    if args.open:
        run("open", str(archive))


def main():
    parser = argparse.ArgumentParser(description="Build an iOS archive for Tarot Squared.")
    version = parser.add_mutually_exclusive_group()
    for part in VERSION_PARTS:
        version.add_argument(f"--{part}", dest="bump", action="store_const", const=part,
                             help=f"Increment the {part} version component")
    parser.add_argument("--no-codesign", action="store_true", help="Build an unsigned archive for local verification")
    parser.add_argument("--open", action="store_true", help="Open the verified archive in Xcode Organizer")
    args = parser.parse_args()
    if args.no_codesign and args.open:
        parser.error("--open requires a signed archive")

    IOS_BUILD.mkdir(parents=True, exist_ok=True)
    with (IOS_BUILD / "archive.lock").open("a", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise ValueError("A Tarot Squared archive is already running in this checkout.") from error
        archive_app(args)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(f"Archive failed running {Path(error.cmd[0]).name}. See the output above.")
    except (OSError, ValueError) as error:
        sys.exit(f"Archive failed: {error}")
