#!/usr/bin/env python3

import argparse
from pathlib import Path
import plistlib
import re
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
APP_NAME = "Tarot Squared"
BUNDLE_ID = "group.kleinfour.games.tarot"


def run(*command):
    subprocess.run(command, cwd=ROOT, check=True)


def main():
    parser = argparse.ArgumentParser(description="Build an iOS archive for Tarot Squared.")
    parser.add_argument("--no-codesign", action="store_true", help="Build an unsigned archive for local verification")
    parser.add_argument("--open", action="store_true", help="Open the verified archive in Xcode Organizer")
    args = parser.parse_args()
    if args.no_codesign and args.open:
        parser.error("--open requires a signed archive")

    pubspec = (ROOT / "pubspec.yaml").read_text(encoding="utf-8")
    version = re.search(r"^version: (\d+\.\d+\.\d+)\+([1-9]\d*)$", pubspec, re.MULTILINE)
    if version is None:
        raise ValueError("Set version: MAJOR.MINOR.PATCH+BUILD in pubspec.yaml.")
    build_name, build_number = version.groups()

    flutter_command = [
        ROOT / "bin/flutter", "build", "ios", "--release",
        "--flavor", APP_NAME, "--config-only", f"--build-name={build_name}",
        f"--build-number={build_number}",
    ]
    if args.no_codesign:
        flutter_command.append("--no-codesign")
    print(f"Preparing Flutter release {build_name} ({build_number})", flush=True)
    run(*flutter_command)

    archives = ROOT / "build/ios/archives"
    archives.mkdir(parents=True, exist_ok=True)
    archive_folder = Path(tempfile.mkdtemp(prefix=f"{build_name}+{build_number}-", dir=archives))
    archive = archive_folder / f"{APP_NAME}.xcarchive"
    command = [
        "xcodebuild", "-quiet", "-workspace", f"ios/{APP_NAME}.xcworkspace",
        "-scheme", APP_NAME, "-destination", "generic/platform=iOS",
        "-derivedDataPath", str(ROOT / "build/ios/archive-derived"),
        "-archivePath", str(archive),
    ]
    if args.no_codesign:
        command.append("CODE_SIGNING_ALLOWED=NO")
        print(f"Archiving {APP_NAME} without signing", flush=True)
    else:
        command.append("-allowProvisioningUpdates")
        print(f"Archiving {APP_NAME} with automatic development signing", flush=True)
    run(*command, "archive")

    with (archive / "Info.plist").open("rb") as metadata:
        archive_info = plistlib.load(metadata)
    for key in ("Name", "SchemeName"):
        if archive_info.get(key) != APP_NAME:
            raise ValueError(f"Expected archive {key}={APP_NAME}, found {archive_info.get(key)!r}.")
    app_path = archive_info.get("ApplicationProperties", {}).get("ApplicationPath")
    if app_path != f"Applications/{APP_NAME}.app":
        raise ValueError(f"Unexpected archived product: {app_path!r}.")
    app = archive / "Products" / app_path
    with (app / "Info.plist").open("rb") as metadata:
        info = plistlib.load(metadata)
    for key, expected in {
        "CFBundleIdentifier": BUNDLE_ID,
        "CFBundleShortVersionString": build_name,
        "CFBundleVersion": build_number,
    }.items():
        if info.get(key) != expected:
            raise ValueError(f"Expected {key}={expected}, found {info.get(key)!r} in {app}.")
    if info.get("ITSAppUsesNonExemptEncryption") is not False:
        raise ValueError(f"Expected ITSAppUsesNonExemptEncryption=false in {app}.")

    if not args.no_codesign:
        if not (app / "embedded.mobileprovision").is_file():
            raise ValueError(f"Missing provisioning profile in {app}.")
        run("codesign", "--verify", "--deep", "--strict", str(app))

    print(f"Verified archive: {archive}", flush=True)
    if args.open:
        run("open", str(archive))


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(f"Archive failed running {Path(error.cmd[0]).name}. See the output above.")
    except (OSError, ValueError) as error:
        sys.exit(f"Archive failed: {error}")
